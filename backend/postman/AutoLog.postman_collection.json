{
  "info": {
    "name": "AutoLog API",
    "description": "Pruebas autenticadas de clientes, vehiculos y ordenes de servicio. Configura authUsername y authPassword en el entorno activo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "clientId", "value": "" },
    { "key": "vehicleId", "value": "" },
    { "key": "serviceOrderId", "value": "" }
  ],
  "item": [
    {
      "name": "POST - Iniciar sesion",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{authUsername}}\",\n  \"password\": \"{{authPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Inicio de sesion correcto', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) { pm.collectionVariables.set('accessToken', pm.response.json().accessToken); }"
          ],
          "type": "text/javascript"
        }
      }]
    },
    {
      "name": "POST - Crear cliente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cliente Postman\",\n  \"identificationNumber\": \"{{$timestamp}}\",\n  \"email\": \"postman-{{$timestamp}}@email.com\",\n  \"phone\": \"3000000000\"\n}"
        },
        "url": "{{baseUrl}}/api/clients"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Cliente creado', function () { pm.response.to.have.status(201); });",
            "pm.collectionVariables.set('clientId', pm.response.json().id);"
          ],
          "type": "text/javascript"
        }
      }]
    },
    {
      "name": "GET - Listar clientes",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/clients" }
    },
    {
      "name": "GET - Buscar cliente creado",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/clients/{{clientId}}" }
    },
    {
      "name": "POST - Crear vehiculo",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicleType\": \"Automovil\",\n  \"brand\": \"Toyota\",\n  \"model\": \"Corolla\",\n  \"plate\": \"POST{{$timestamp}}\",\n  \"chassisNumber\": \"VIN{{$timestamp}}\",\n  \"vehicleYear\": 2024,\n  \"client\": {\n    \"id\": {{clientId}}\n  }\n}"
        },
        "url": "{{baseUrl}}/api/vehicles"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Vehiculo creado', function () { pm.response.to.have.status(201); });",
            "pm.collectionVariables.set('vehicleId', pm.response.json().id);"
          ],
          "type": "text/javascript"
        }
      }]
    },
    {
      "name": "GET - Listar vehiculos",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/vehicles" }
    },
    {
      "name": "GET - Buscar vehiculo creado",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/vehicles/{{vehicleId}}" }
    },
    {
      "name": "POST - Crear orden de servicio",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"entryDate\": \"2026-08-25\",\n  \"primaryReason\": \"Revision general\",\n  \"currentMileage\": 10000,\n  \"customerObservations\": \"Prueba desde Postman\",\n  \"vehicle\": {\n    \"id\": {{vehicleId}}\n  }\n}"
        },
        "url": "{{baseUrl}}/api/service-orders"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Orden creada', function () { pm.response.to.have.status(201); });",
            "pm.collectionVariables.set('serviceOrderId', pm.response.json().id);"
          ],
          "type": "text/javascript"
        }
      }]
    },
    {
      "name": "GET - Listar ordenes",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/service-orders" }
    },
    {
      "name": "GET - Buscar orden creada",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/service-orders/{{serviceOrderId}}" }
    }
  ]
}
